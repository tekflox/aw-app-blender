{
  "mcpServers": {
    "aw-blender": {
      "enabled": true,
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "mcp_server.server"
      ],
      "cwd": "/opt/aw-workspace/apps/blender",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "BLENDER_HOST": "aw-app-blender",
        "BLENDER_PORT": "9876"
      }
    }
  }
}
